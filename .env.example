# Public URL of the deployed site, used to build Stripe's return URLs.
SITE_URL=https://your-domain.com

# Stripe — from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
# Signing secret for the /api/stripe-webhook endpoint. Create the endpoint in
# Stripe first (listening for checkout.session.completed), then copy its secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Shopify bridge that Tapstitch watches. From the Shopify Dev Dashboard app;
# it needs write_draft_orders, write_orders and read_products.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
